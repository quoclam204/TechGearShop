@model IEnumerable<EcommerceMVC.ViewModels.CartItem>

@{
    ViewData["Title"] = "Checkout";
}

<div class="container-fluid page-header py-5">

    <ol class="breadcrumb justify-content-center mb-0">
       
    </ol>
</div>

<div class="container-fluid py-5">
    <div class="container py-5">
        <h1 class="mb-4">Thông tin hóa đơn</h1>

        <form asp-action="Checkout" asp-controller="Cart" method="post">
            <div class="row">
                <div class="col-md-12 col-lg-6 col-xl-7">
                    <div class="p-4 shadow-sm rounded bg-white">

                        <h4 class="mb-3 fw-semibold">Thông tin nhận hàng</h4>

                        <!-- Checkbox -->
                        <div class="form-check custom-check mb-3">
                            <input type="checkbox" name="GiongKhachHang"
                                   class="form-check-input"
                                   id="GiongKhachHang" value="false">
                            <label class="form-check-label" for="GiongKhachHang">
                                Giống thông tin khách hàng
                            </label>
                        </div>

                        <!-- Thông tin -->
                        <div class="delivery-info">
                            <div class="mb-3">
                                <label class="form-label">Người nhận hàng <sup>*</sup></label>
                                <input type="text" name="HoTen" class="form-control">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Địa chỉ nhận hàng <sup>*</sup></label>
                                <input type="text" name="DiaChi" class="form-control"
                                       placeholder="01 Phù Đổng Thiên Vương, Đà Lạt">
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Điện thoại <sup>*</sup></label>
                                <input type="text" name="DienThoai" class="form-control">
                            </div>
                        </div>

                        <!-- Ghi chú -->
                        <div class="mb-3">
                            <label class="form-label">Ghi chú</label>
                            <textarea name="GhiChu"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Nhập ghi chú nếu có..."></textarea>
                        </div>

                        <!-- ❌ GIỮ NGUYÊN NÚT -->
                        <div class="row g-4 text-center align-items-center justify-content-center pt-4">
                            <button type="submit" class="btn border-secondary py-3 px-4 text-uppercase w-100 text-primary">
                                Đặt hàng
                            </button>
                        </div>

                    </div>
                </div>

                <div class="col-md-12 col-lg-6 col-xl-5">
                    <div class="p-4 shadow-sm rounded bg-white">
                        <h4 class="mb-4 fw-semibold">Đơn hàng của bạn</h4>

                        <div class="table-responsive">
                            <table class="table align-middle order-table">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 80px;">SP</th>
                                        <th style="width: 180px;">Tên</th>
                                        <th>Giá</th>
                                        <th>SL</th>
                                        <th>Tổng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <!-- Ảnh -->
                                            <td>
                                                <img src="~/Hinh/HangHoa/@item.Hinh"
                                                     class="rounded"
                                                     style="width: 60px; height: 60px; object-fit: cover;"
                                                     alt="@item.TenHH">
                                            </td>

                                            <!-- Tên sản phẩm -->
                                            <td class="product-name" title="@item.TenHH">
                                                @item.TenHH
                                            </td>

                                            <!-- Giá -->
                                            <td class="text-nowrap">
                                                @item.DonGia.ToString("N0") ₫
                                            </td>

                                            <!-- Số lượng -->
                                            <td class="text-nowrap text-center">
                                                @item.SoLuong
                                            </td>

                                            <!-- Thành tiền -->
                                            <td class="text-danger fw-semibold text-nowrap">
                                                @item.ThanhTien.ToString("N0") ₫
                                            </td>
                                        </tr>
                                    }

                                    <!-- Tổng -->
                                    <tr class="border-top total-row">
                                        <td colspan="3"></td>
                                        <td class="fw-bold text-end">Tổng:</td>
                                        <td class="fw-bold text-danger fs-5 text-nowrap">
                                            @Model.Sum(p => p.ThanhTien).ToString("N0") ₫
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            $("#GiongKhachHang").on("change", function () {
                const checked = this.checked;
                $(this).val(checked ? "true" : "false");
                $(".delivery-info").toggleClass("d-none", checked);
            }).trigger("change"); // áp dụng trạng thái ngay khi load
        });
    </script>
}