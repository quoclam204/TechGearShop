@model IEnumerable<EcommerceMVC.ViewModels.HangHoaVM>
@{
    ViewData["Title"] = "Kết quả tìm kiếm";
    Layout = "_LayoutSearch";
}

@section Styles {
    <link href="~/css/product-card.css" rel="stylesheet" />
}

@section BreadCum {
    <div class="container-fluid page-header py-5">
    </div>
}

<!-- Layout 2 cột: Sidebar trái + Sản phẩm phải -->
<div class="row g-4">
    <!-- SIDEBAR BÊN TRÁI (col-lg-3) -->
    <div class="col-lg-3">
        <div class="row g-4">
            <!-- 4. Banner quảng cáo -->
            <div class="col-lg-12">
                <div class="position-relative">
                    <img src="~/img/banner2.png" class="img-fluid w-100 rounded" alt="Đặc biệt">
                    @* <div class="position-absolute" style="top: 50%; right: 10px; transform: translateY(-50%);">
                        <h3 class="text-secondary fw-bold">Đặc <br> Biệt</h3>
                    </div> *@
                </div>
            </div>

            @* <!-- 1. Menu Loại sản phẩm -->
            <div class="col-lg-12">
                @await Component.InvokeAsync("MenuLoai")
            </div> *@

            <!-- 2. Sản phẩm nổi bật -->
            <div class="col-lg-12">
                @await Component.InvokeAsync("FeaturedProducts", new { count = 5 })
            </div>

        </div>
    </div>

    <!-- NỘI DUNG BÊN PHẢI (col-lg-9) -->
    <div class="col-lg-9">
        <!-- Thông báo kết quả tìm kiếm -->
        <div class="row mb-4">
            <div class="col-12">
                @if (!string.IsNullOrWhiteSpace(ViewBag.SearchQuery))
                {
                    <div class="alert alert-info d-flex align-items-center">
                        <i class="fas fa-search me-3 fa-2x"></i>
                        <div>
                            <strong>Tìm thấy @ViewBag.TotalResults sản phẩm</strong> cho từ khóa: 
                            <span class="badge bg-primary">@ViewBag.SearchQuery</span>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        Vui lòng nhập từ khóa để tìm kiếm
                    </div>
                }
            </div>
        </div>

        <!-- Danh sách sản phẩm -->
        @if (Model != null && Model.Any())
        {
            <div class="product-grid">
                @await Html.PartialAsync("_ProductGrid", Model)
            </div>
        }
        else
        {
            <div class="row">
                <div class="col-12 text-center py-5">
                    <i class="fas fa-box-open fa-4x text-muted mb-4"></i>
                    <h4>Không tìm thấy sản phẩm phù hợp</h4>
                    <p class="text-muted">Hãy thử tìm kiếm với từ khóa khác hoặc xem tất cả sản phẩm</p>
                    <a asp-controller="HangHoa" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 mt-3">
                        <i class="fas fa-shopping-bag me-2"></i>Xem tất cả sản phẩm
                    </a>
                </div>
            </div>
        }
    </div>
</div>