@model IEnumerable<EcommerceMVC.ViewModels.HangHoaVM>

<div class="featured-products-section">
    <h5 class="featured-title mb-3">
        <i class="fas fa-star text-warning me-2"></i>
        Sản phẩm nổi bật
    </h5>
    @foreach (var product in Model)
    {
        <div class="d-flex align-items-center justify-content-start mb-3">
            <a asp-controller="HangHoa" asp-action="Detail" asp-route-id="@product.MaHh" 
               class="text-decoration-none d-flex align-items-center w-100">
                <div class="rounded me-3" style="width: 80px; height: 80px; overflow: hidden;">
                    <img src="~/Hinh/HangHoa/@product.Hinh" 
                         class="img-fluid" 
                         style="width: 100%; height: 100%; object-fit: cover;"
                         alt="@product.TenHH">
                </div>
                <div>
                    <h6 class="mb-1 text-dark">@product.TenHH</h6>
                    <div class="d-flex mb-1">
                        <i class="fa fa-star text-warning"></i>
                        <i class="fa fa-star text-warning"></i>
                        <i class="fa fa-star text-warning"></i>
                        <i class="fa fa-star text-warning"></i>
                        <i class="fa fa-star text-muted"></i>
                    </div>
                    <div class="d-flex">
                        <span class="text-primary fw-bold">@product.DonGia.ToString("N0") ₫</span>
                    </div>
                </div>
            </a>
        </div>
    }
</div>