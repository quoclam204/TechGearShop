@model EcommerceMVC.ViewModels.LoginVM

<div class="mb-3">
	<div class="alert alert-warning mb-0">
		Vui lòng đăng nhập để thêm sản phẩm vào giỏ hàng.
	</div>
</div>

<form id="loginModalForm" asp-controller="Home" asp-action="DangNhap" method="post">
	<input type="hidden" name="ReturnUrl" id="loginModalReturnUrl" value="/" />

	<div class="text-danger" data-valmsg-summary="true"></div>

	<div class="mb-3">
		<label asp-for="UserName" class="form-label"></label>
		<input asp-for="UserName" class="form-control" name="UserName" autocomplete="username" />
		<span asp-validation-for="UserName" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label asp-for="Password" class="form-label"></label>
		<input asp-for="Password" class="form-control" name="Password" autocomplete="current-password" />
		<span asp-validation-for="Password" class="text-danger"></span>
	</div>

	<button type="submit" class="btn btn-primary w-100">
		Đăng nhập
	</button>

	<div class="d-flex justify-content-between mt-3">
		<a asp-controller="Home" asp-action="DangKy" class="btn btn-link p-0">Đăng ký</a>
		<a asp-controller="Home" asp-action="QuenMatKhau" class="btn btn-link p-0">Quên mật khẩu</a>
	</div>
</form>