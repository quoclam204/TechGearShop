@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model EcommerceMVC.Data.HangHoa

@{
    ViewData["Title"] = "SuaSanPham";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container mt-4">
    <h1 class="text-center text-primary">Sửa sản phẩm</h1>
    <hr />

    <form method="post" asp-action="SuaSanPham" class="shadow p-4 bg-light rounded" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="MaHh" />
        <input type="hidden" asp-for="Hinh" />

        <h4 class="text-secondary">Thông Tin Sản Phẩm</h4>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="TenHh" class="form-label fw-bold">Tên Hàng Hóa</label>
                    <input asp-for="TenHh" class="form-control" />
                    <span asp-validation-for="TenHh" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="TenAlias" class="form-label fw-bold">Tên Alias</label>
                    <input asp-for="TenAlias" class="form-control" />
                    <span asp-validation-for="TenAlias" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="MaLoai" class="form-label fw-bold">Loại Sản Phẩm</label>
                    <select asp-for="MaLoai" class="form-select" asp-items="ViewBag.MaLoai"></select>
                    <span asp-validation-for="MaLoai" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="MoTaDonVi" class="form-label fw-bold">Mô Tả Đơn Vị</label>
                    <input asp-for="MoTaDonVi" class="form-control" />
                    <span asp-validation-for="MoTaDonVi" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="DonGia" class="form-label fw-bold">Đơn Giá</label>
                    <input asp-for="DonGia" class="form-control" />
                    <span asp-validation-for="DonGia" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label fw-bold">Hình hiện tại</label>
                    <div class="mb-2">
                        @if (!string.IsNullOrWhiteSpace(Model.Hinh))
                        {
                            <img src="@($"/Hinh/HangHoa/{Model.Hinh}")" style="max-height:120px" />
                        }
                    </div>

                    <label class="form-label fw-bold">Đổi hình (nếu muốn)</label>
                    <input type="file" name="HinhUpload" class="form-control" accept="image/*" />
                </div>

                <div class="form-group mb-3">
                    <label asp-for="NgaySx" class="form-label fw-bold">Ngày Sản Xuất</label>
                    <input asp-for="NgaySx" type="date" class="form-control" />
                    <span asp-validation-for="NgaySx" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="GiamGia" class="form-label fw-bold">Giảm Giá (%)</label>
                    <input asp-for="GiamGia" class="form-control" />
                    <span asp-validation-for="GiamGia" class="text-danger"></span>
                </div>
            </div>
        </div>

        <h4 class="text-secondary mt-4">Thông Tin Bổ Sung</h4>
        <div class="row g-3">
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="SoLanXem" class="form-label fw-bold">Số Lần Xem</label>
                    <input asp-for="SoLanXem" class="form-control" />
                    <span asp-validation-for="SoLanXem" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="MoTa" class="form-label fw-bold">Mô Tả</label>
                    <textarea asp-for="MoTa" class="form-control"></textarea>
                    <span asp-validation-for="MoTa" class="text-danger"></span>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="MaNcc" class="form-label fw-bold">Nhà Cung Cấp</label>
                    <select asp-for="MaNcc" class="form-select" asp-items="ViewBag.MaNcc"></select>
                    <span asp-validation-for="MaNcc" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary mt-3">Sửa Sản Phẩm</button>
        </div>
    </form>

    <div class="mt-4">
        <a asp-action="DanhMucSanPham" class="btn btn-secondary">Quay Lại Danh Sách</a>
    </div>
</div>
